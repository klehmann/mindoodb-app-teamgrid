+/// Anything the package readers can pull ZIP bytes from: a file natively,
+/// an in-memory buffer for workbooks opened from bytes (the WASM build).
+pub trait ZipSource: Read + Seek {}
+
+impl<T: Read + Seek> ZipSource for T {}
+
+/// Where a session's package lives; reopened per indexer / media read.
+#[derive(Clone)]
+enum WorkbookSource {
+    Path(PathBuf),
+    Memory(Arc<[u8]>),
+}
+
+enum SourceReader {
+    File(File),
+    Memory(Cursor<Arc<[u8]>>),
+}
+
+impl Read for SourceReader {
+    fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+        match self {
+            Self::File(file) => file.read(buffer),
+            Self::Memory(cursor) => cursor.read(buffer),
+        }
+    }
+}
+
+impl Seek for SourceReader {
+    fn seek(&mut self, position: SeekFrom) -> std::io::Result<u64> {
+        match self {
+            Self::File(file) => file.seek(position),
+            Self::Memory(cursor) => cursor.seek(position),
+        }
+    }
+}
+
+impl WorkbookSource {
+    fn archive(&self) -> Result<ZipArchive<SourceReader>, SidecarError> {
+        let reader = match self {
+            Self::Path(path) => SourceReader::File(File::open(path)?),
+            Self::Memory(bytes) => SourceReader::Memory(Cursor::new(Arc::clone(bytes))),
+        };
+        Ok(ZipArchive::new(reader)?)
+    }
+}
