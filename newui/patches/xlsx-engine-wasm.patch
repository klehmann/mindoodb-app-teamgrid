+/// A byte-backed session (the browser build's only kind) keeps its chunks
+/// in memory but must answer exactly like the file-backed one.
+#[test]
+fn byte_backed_session_matches_file_backed_session() {
+    let (_dir, path) = open_fixture(&[
+        (
+            "xl/workbook.xml",
+            r#"<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="S" sheetId="1" r:id="rId1"/></sheets></workbook>"#,
+        ),
+        (
+            "xl/_rels/workbook.xml.rels",
+            r#"<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/></Relationships>"#,
+        ),
+        (
+            "xl/worksheets/sheet1.xml",
+            r#"<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
+<sheetData><row r="1"><c r="A1"><v>1</v></c><c r="B1"><f>A1*2</f><v>2</v></c></row>
+<row r="300"><c r="C300"><v>3</v></c></row></sheetData>
+<mergeCells count="1"><mergeCell ref="A2:B3"/></mergeCells>
+</worksheet>"#,
+        ),
+    ]);
+    let read_all = |sessions: &mut WorkbookSessions, metadata: &WorkbookMetadata| {
+        let sheet_id = metadata.sheets[0].id.clone();
+        let range = CellRange {
+            start_row: 0,
+            end_row: 299,
+            start_column: 0,
+            end_column: 2,
+        };
+        let result = loop {
+            let result = sessions
+                .read_range(&metadata.session_id, &sheet_id, &range)
+                .unwrap();
+            if result.indexing_complete {
+                break result;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(5));
+        };
+        let formulas = sessions
+            .read_formula_cells(&metadata.session_id, &sheet_id)
+            .unwrap();
+        (
+            serde_json::to_value(result).unwrap(),
+            serde_json::to_value(formulas).unwrap(),
+        )
+    };
+    let mut sessions = WorkbookSessions::new();
+    let from_file = sessions.open(&path).unwrap();
+    let bytes = std::fs::read(&path).unwrap();
+    let from_bytes = sessions
+        .open_bytes(bytes, "fixture.xlsx", "zh", None)
+        .unwrap();
+    assert_eq!(from_bytes.name, "fixture.xlsx");
+    assert!(sessions.session_path(&from_bytes.session_id).is_none());
+    let file_result = read_all(&mut sessions, &from_file);
+    let bytes_result = read_all(&mut sessions, &from_bytes);
+    assert_eq!(file_result, bytes_result);
+    assert_eq!(file_result.0["cells"].as_array().unwrap().len(), 3);
+    sessions.close(&from_bytes.session_id).unwrap();
+}
